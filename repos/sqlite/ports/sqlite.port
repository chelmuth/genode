LICENSE   := PublicDomain
VERSION   := 3490100
DOWNLOADS := sqlite.archive speedtest.file

# don't forget to bump the year in the url!
URL(sqlite) := https://sqlite.org/2025/sqlite-amalgamation-$(VERSION).zip
SHA(sqlite) := 6cebd1d8403fc58c30e93939b246f3e6e58d0765a5cd50546f16c00fd805d2c3
DIR(sqlite) := src/lib/sqlite

URL(speedtest) := https://raw.githubusercontent.com/sqlite/sqlite/version-3.49.1/test/speedtest1.c
SHA(speedtest) := ae0b359792df2339590cac985228875ebdabb73c2c45a2d6c4a79600fb19f8c7
NAME(speedtest) := src/lib/sqlite/speedtest1.c

UNZIP_OPT(sqlite) := -j

DIRS := include/sqlite
DIR_CONTENT(include/sqlite) := src/lib/sqlite/sqlite3.h src/lib/sqlite/sqlite3ext.h
