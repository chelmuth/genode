# configuration decisions
drivers: pc
system:  pc
gpu_drv: intel

# supplemental depot content added to the system image
import: pkg/drivers_managed-pc pkg/wifi src/ipxe_nic_drv

# selection of launcher-menu entries
launcher: vm_fs shared_fs usb_devices_rom

# selection of accepted depot-package providers
depot: genodelabs cnuke alex-ab mstein nfeske cproc chelmuth jschlatow
depot: ssumpf skalk

# devel
depot:    chelmuth_test
#import:   pkg/vbox6
ram_fs:   depot
deploy:   devel
usb:      devel
launcher: arch_fs vbox6_arch ubuntu_fs vbox6_ubuntu vbox6_usb_devices
build:    app/top
build:    virtualbox6
#build:    app/driver_manager app/sculpt_manager
#build:    drivers/usb_host/pc
#build:    drivers/usb_block
#build:    server/vfs lib/vfs/rump
